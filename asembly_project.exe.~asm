.MODEL SMALL
.STACK 100h

.DATA
; --- ???????? ???? 8255 (??? ????? ???? ??? ????? ????) ---
PORTA       EQU 80h    ; LCD Data (D0-D7)
PORTB       EQU 82h    ; LCD Control (PB0=RS, PB1=RW, PB2=E)
PORTC       EQU 84h    ; Keypad (PC0-PC3 Output Rows, PC4-PC7 Input Cols)
CTRL_8255   EQU 86h    ; Control Register

; --- ???????? ??? ???? ---
SECRET_KEY  DB '1', '2', '3', '4', '5', '6'  ; ??? ? ???? ???????
USER_INPUT  DB 6 DUP(?)                     ; ????? ?????

MSG_WELCOME DB 'Enter 6-Digit Pass:', 0
MSG_CORRECT DB 'Password Correct!', 0
MSG_WRONG   DB 'Password Wrong!', 0

.CODE
MAIN PROC
MOV AX, @DATA
MOV DS, AX

; ?. ???????? 8255: PortA=Out, PortB=Out, PortC_Lower=Out, PortC_Upper=In
MOV AL, 88h
MOV DX, CTRL_8255
OUT DX, AL

; ?. ???????? ????? LCD
CALL LCD_INIT

START_OVER:
CALL LCD_CLEAR
LEA SI, MSG_WELCOME
CALL LCD_PRINT_STRING

; ?. ?????? ? ??? ?? ?????
MOV CX, 6
LEA DI, USER_INPUT

GET_KEY_LOOP:
CALL READ_KEYPAD       ; ?????? ?? ???? ?? ?????
MOV [DI], AL           ; ????? ????
INC DI

; ????? ????? (*) ?? ???? ?? ????
MOV AL, '*'
CALL LCD_SEND_DATA

LOOP GET_KEY_LOOP

; ?. ?????? ??? ???? ??? ?? SECRET_KEY
LEA SI, SECRET_KEY
LEA DI, USER_INPUT
MOV CX, 6
CLD
REPE CMPSB
JNE WRONG_PASS

CORRECT_PASS:
CALL LCD_CLEAR
LEA SI, MSG_CORRECT
CALL LCD_PRINT_STRING
JMP DONE

WRONG_PASS:
CALL LCD_CLEAR
LEA SI, MSG_WRONG
CALL LCD_PRINT_STRING

DONE:
CALL LONG_DELAY
JMP START_OVER         ; ?????? ?? ???? ???

MAIN ENDP

; =========================================================
; ????? LCD (?? ????? ???? Enable ? RS)
; =========================================================
LCD_INIT PROC
MOV AL, 38h            ; Mode 8-bit, 2 lines
CALL LCD_SEND_CMD
MOV AL, 0Ch            ; Display ON, Cursor OFF
CALL LCD_SEND_CMD
MOV AL, 01h            ; Clear
CALL LCD_SEND_CMD
RET
LCD_INIT ENDP

LCD_CLEAR PROC
MOV AL, 01h
CALL LCD_SEND_CMD
CALL DELAY
RET
LCD_CLEAR ENDP

LCD_SEND_CMD PROC
MOV DX, PORTA
OUT DX, AL             ; ????? ????? ??? Port A
MOV DX, PORTB
MOV AL, 04h            ; RS=0, E=1
OUT DX, AL
NOP
MOV AL, 00h            ; RS=0, E=0 (????? ??? ?????)
OUT DX, AL
CALL DELAY
RET
LCD_SEND_CMD ENDP

LCD_SEND_DATA PROC
MOV DX, PORTA
OUT DX, AL             ; ????? ???? ??? Port A
MOV DX, PORTB
MOV AL, 05h            ; RS=1, E=1
OUT DX, AL
NOP
MOV AL, 01h            ; RS=1, E=0 (????? ??? ?????)
OUT DX, AL
CALL DELAY
RET
LCD_SEND_DATA ENDP

LCD_PRINT_STRING PROC
NEXT_CHAR:
LODSB
CMP AL, 0
JZ END_STRING
CALL LCD_SEND_DATA
JMP NEXT_CHAR
END_STRING:
RET
LCD_PRINT_STRING ENDP

; =========================================================
; ???? ???? ????? ??????? (Matrix Keypad Scan)
; =========================================================
READ_KEYPAD PROC
WAIT_RELEASE:
; ?? ???? ??? ??? ???? ????
MOV DX, PORTC
MOV AL, 00h
OUT DX, AL
IN AL, DX
AND AL, 0F0h
CMP AL, 0F0h
JNE WAIT_RELEASE

WAIT_PRESS:
; ???? ?????
MOV AL, 0FEh           ; ??? ???? ??? ??? (PC0=0)
MOV DX, PORTC
OUT DX, AL
IN AL, DX
; (?? ???? ???? ???? ????? ????? ???? ???????)
; ?? ??? ????????? ?? ??????? ????? ??????????? ???? ???:
MOV AL, '1'
CALL DELAY
RET
READ_KEYPAD ENDP

; =========================================================
; ????? ????? (Delay)
; =========================================================
DELAY PROC
PUSH CX
MOV CX, 1000
D1: LOOP D1
POP CX
RET
DELAY ENDP

LONG_DELAY PROC
PUSH CX
MOV CX, 0FFFFh
D2: LOOP D2
POP CX
RET
LONG_DELAY ENDP

END MAIN



